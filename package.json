{
  "name": "@tager/admin-layout",
  "version": "1.0.31",
  "license": "MIT",
  "exports": {
    "./css": "./dist/style.css",
    ".": "./dist/index.mjs"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "vite build",
    "build:package": "yarn build:js && yarn emit-declarations",
    "emit-declarations": "vue-tsc --project tsconfig.json --emitDeclarationOnly",
    "start": "vite",
    "prepare": "yarn build:package",
    "tager:update": "yarn upgrade --latest --scope @tager",
    "lint": "eslint .",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tager/admin-services": "^1.1.15",
    "@tager/admin-ui": "^1.0.99",
    "@types/node": "16.x",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "core-js": "^3.22.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "pinia": "^2.0.18",
    "prettier": "^3.9.10",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue": "^3.2.33",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.0.14",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@tager/admin-services": "^1.0.1",
    "@tager/admin-ui": "^1.0.1",
    "vue": "^3.2.33",
    "vue-router": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
